# Kite Connect app credentials from https://developers.kite.trade/apps
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Encrypts access tokens and per-account secrets in the SQLite DB.
# Generate with: python manage.py gen-key
TOKEN_ENCRYPTION_KEY=

# Optional shared secret for /login, /accounts and /copies (?admin_token=...).
# Strongly recommended if the server is reachable from anywhere but localhost.
ADMIN_TOKEN=

# DB_PATH=accounts.db
# MAX_WORKERS=10            # parallel child orders; Kite allows ~10 orders/sec per API key
# COPY_ORDER_TAG=COPYTRADE  # tag on child orders, max 20 chars
# FORCE_MARKET_ORDERS=false # copy LIMIT/SL master orders as MARKET to guarantee fills
# DRY_RUN=false             # log child orders instead of placing them
# LOG_LEVEL=INFO
